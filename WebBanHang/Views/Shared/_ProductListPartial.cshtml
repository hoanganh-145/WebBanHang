@model PaginatedList<Product>

<div id="product-table-container">
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Name</th>
                <th>Price</th>
                <th>Category</th>
                <th>Image</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var x in Model)
            {
                <tr>
                    <td>@x.Name</td>
                    <td>@x.Price</td>
                    <td>@x.Category.Name</td>
                    <td>
                        @if (x.ImageUrl != null)
                        {
                            <img src="@x.ImageUrl" style="width:100px" />
                        }
                    </td>
                    <td>
                        <a asp-action="Update" asp-route-id="@x.Id" class="btn btn-success">
                            <i class="bi bi-pencil-square"></i> Edit
                        </a>
                        <a asp-action="Delete" asp-route-id="@x.Id" class="btn btn-danger">
                            <i class="bi bi-trash"></i> Delete
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <!-- Pagination Controls -->
    <div class="row" id="pagination-container">
        <div class="col-12">
            <nav aria-label="Page navigation">
                <ul class="pagination justify-content-center">
                    @{
                        var prevDisabled = !Model.HasPreviousPage ? "disabled" : "";
                        var nextDisabled = !Model.HasNextPage ? "disabled" : "";

                        const int maxPagesToShow = 5;
                        int startPage = Math.Max(1, Model.PageIndex - (maxPagesToShow / 2));
                        int endPage = Math.Min(Model.TotalPages, startPage + maxPagesToShow - 1);


                        if (endPage - startPage + 1 < maxPagesToShow && startPage > 1)
                        {
                            startPage = Math.Max(1, endPage - maxPagesToShow + 1);
                        }
                    }

                    <!-- First page button -->
                    <li class="page-item @(Model.PageIndex == 1 ? "disabled" : "")">
                        <a href="javascript:void(0)"
                           onclick="loadPage(1)"
                           class="page-link" title="First page">
                            <i class="bi bi-chevron-double-left"></i>
                        </a>
                    </li>

                    <!-- Previous page button -->
                    <li class="page-item @prevDisabled">
                        <a href="javascript:void(0)"
                           onclick="loadPage(@(Model.PageIndex - 1))"
                           class="page-link @prevDisabled" title="Previous page">
                            <i class="bi bi-chevron-left"></i>
                        </a>
                    </li>

                    <!-- Page numbers -->
                    @if (startPage > 1)
                    {
                        <li class="page-item disabled">
                            <span class="page-link">...</span>
                        </li>
                    }

                    @for (int i = startPage; i <= endPage; i++)
                    {
                        <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                            <a href="javascript:void(0)"
                               onclick="loadPage(@i)"
                               class="page-link">@i</a>
                        </li>
                    }

                    @if (endPage < Model.TotalPages)
                    {
                        <li class="page-item disabled">
                            <span class="page-link">...</span>
                        </li>
                    }

                    <!-- Next page button -->
                    <li class="page-item @nextDisabled">
                        <a href="javascript:void(0)"
                           onclick="loadPage(@(Model.PageIndex + 1))"
                           class="page-link @nextDisabled" title="Next page">
                            <i class="bi bi-chevron-right"></i>
                        </a>
                    </li>

                    <!-- Last page button -->
                    <li class="page-item @(Model.PageIndex == Model.TotalPages ? "disabled" : "")">
                        <a href="javascript:void(0)"
                           onclick="loadPage(@Model.TotalPages)"
                           class="page-link" title="Last page">
                            <i class="bi bi-chevron-double-right"></i>
                        </a>
                    </li>
                </ul>
            </nav>
        </div>
    </div>

    
    <div class="text-center">
        <p>
            Showing page @Model.PageIndex of @Model.TotalPages
            (Total products: @Model.TotalItems)
        </p>
    </div>
</div>